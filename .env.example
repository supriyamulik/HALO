# ========================================
# HALO Workspace Environment Configuration
# ========================================

# Groq API Configuration for Legal LLM Answer Generation
# Obtain key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Secret key for JWT auth (change in production)
SECRET_KEY=halo-dev-insecure-secret-key-change-in-production

# Database URL (defaults to local SQLite)
DATABASE_URL=sqlite:///./halo.db
