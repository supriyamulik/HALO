# ========================================
# HALO Backend Environment Configuration
# ========================================

# Groq API Configuration for Legal LLM Answer Generation
# Obtain key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Secret key for JWT auth (change in production)
SECRET_KEY=halo-dev-insecure-secret-key-change-in-production

# Database URL (defaults to local SQLite)
DATABASE_URL=sqlite:///./halo.db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=HALO_NyayaSahyak_bot

# NewsAPI Configuration (Optional, falls back to Google News India legal feed)
NEWS_API_KEY=your_newsapi_org_key_here

# Path to precomputed HALO indices (optional override)
# HALO_INDICES_DIR=d:/HALO/HALO-new/experiments/indices
